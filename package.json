{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Personal extensions for the Pi coding agent",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./claude-ui/index.ts",
      "./voice-dictation/index.ts",
      "./usage/usage.ts",
      "./session-name/index.ts",
      "./aliases/index.ts"
    ],
    "themes": [
      "./claude-ui/themes/claude-dark.json",
      "./claude-ui/themes/claude-light.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^24.12.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck"
  }
}
