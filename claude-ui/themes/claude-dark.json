{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "claude-dark",
  "comment": "Mirrors Claude Code's dark-ansi theme: colors 0-15 are named ANSI colors, so everything resolves through the user's own terminal palette (iTerm2). black=0 red=1 green=2 yellow=3 blue=4 magenta=5 cyan=6 white=7 + bright variants.",
  "vars": {
    "black": 0,
    "red": 1,
    "green": 2,
    "yellow": 3,
    "blue": 4,
    "magenta": 5,
    "cyan": 6,
    "white": 7,
    "blackBright": 8,
    "redBright": 9,
    "greenBright": 10,
    "yellowBright": 11,
    "blueBright": 12,
    "magentaBright": 13,
    "cyanBright": 14,
    "whiteBright": 15
  },
  "colors": {
    "accent": "redBright",
    "border": "white",
    "borderAccent": "yellowBright",
    "borderMuted": "blackBright",
    "success": "greenBright",
    "error": "redBright",
    "warning": "yellowBright",
    "muted": "white",
    "dim": "blackBright",
    "text": "",
    "thinkingText": "white",

    "selectedBg": "blackBright",
    "scrollbarThumb": "blackBright",
    "searchMatchBg": "blue",
    "searchMatchText": "whiteBright",
    "userMessageBg": "blackBright",
    "userMessageText": "",
    "customMessageBg": "blackBright",
    "customMessageText": "",
    "customMessageLabel": "redBright",
    "toolPendingBg": "blackBright",
    "toolSuccessBg": "blackBright",
    "toolErrorBg": "red",
    "toolTitle": "redBright",
    "toolOutput": "white",

    "mdHeading": "redBright",
    "mdLink": "blueBright",
    "mdLinkUrl": "white",
    "mdCode": "redBright",
    "mdCodeBlock": "",
    "mdCodeBlockBorder": "white",
    "mdQuote": "white",
    "mdQuoteBorder": "blackBright",
    "mdHr": "blackBright",
    "mdListBullet": "white",

    "toolDiffAdded": "greenBright",
    "toolDiffRemoved": "redBright",
    "toolDiffContext": "white",

    "syntaxComment": "blackBright",
    "syntaxKeyword": "magentaBright",
    "syntaxFunction": "blueBright",
    "syntaxVariable": "redBright",
    "syntaxString": "greenBright",
    "syntaxNumber": "yellowBright",
    "syntaxType": "cyanBright",
    "syntaxOperator": "white",
    "syntaxPunctuation": "white",

    "thinkingOff": "white",
    "thinkingMinimal": "white",
    "thinkingLow": "white",
    "thinkingMedium": "white",
    "thinkingHigh": "white",
    "thinkingXhigh": "white",
    "thinkingMax": "white",

    "bashMode": "magentaBright",

    "footerModel": "cyan",
    "footerDim": "blackBright",
    "footerWarn": "yellow",
    "footerPath": "blue",
    "footerGit": "magenta",
    "footerReason": "green"
  },
  "export": {
    "pageBg": "#000000",
    "cardBg": "#1a1a1a",
    "infoBg": "#2c323e"
  }
}
